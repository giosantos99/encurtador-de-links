{
  "name": "encurtador-de-links",
  "version": "1.0.0",
  "description": "Aplicação web para encurtamento de URLs com Express, Pug, Sass e Bootstrap",
  "license": "ISC",
  "author": "Giovanna Santos de Souza",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "npm-run-all --parallel watch:scss watch:server",
    "watch:server": "nodemon index.js",
    "watch:scss": "sass --watch src/scss:public/css",
    "build:css": "sass src/scss:public/css --style=compressed --no-source-map",
    "build": "npm run build:css"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "sass": "^1.102.0"
  }
}
