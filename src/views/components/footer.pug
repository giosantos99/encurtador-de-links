footer
  div(class="container-hits-info bg-secondary d-flex align-items-center")
    div(class="triangulo bg-grey mb-4")
    div(class="d-grid gap-3 text-center pb-2")
      div(class="text-primary fs-3") Hits
      div(class="rounded-3 text-primary border border-dark-subtle px-3 py-2 bg-grey") #{ total }
      div(class="text-secondary-emphasis fw-semibold") Clique em links

  div(class="container-redes-sociais d-flex align-items-center justify-content-between")
    img(
      src="/assets/logo-chaordic.png"
      alt="Logo chaordic"
    )
    div(class="d-flex flex-nowrap gap-3")
      a(href="#")
        img(
          src="/assets/icon-facebook.png"
          alt="Logo Facebook"
        )
      a(href="#")
        img(
          src="/assets/icon-twitter.png"
          alt="Logo Twitter"
        )